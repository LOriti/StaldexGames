    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  },
  "optionalDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
