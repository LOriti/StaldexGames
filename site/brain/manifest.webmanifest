{
  "name": "Brain",
  "short_name": "Brain",
  "description": "Leon's command centre: the one thing, the inbox, next actions.",
  "start_url": "/brain/#focus",
  "scope": "/brain/",
  "display": "standalone",
  "background_color": "#f4f2ec",
  "theme_color": "#2d5b4e",
  "icons": [
    { "src": "/brain/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/brain/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Capture", "url": "/brain/#capture", "description": "Add a line to the inbox" },
    { "name": "Search", "url": "/brain/#search", "description": "Find a card, item or line" }
  ],
  "share_target": { "action": "/brain/", "method": "GET", "params": { "title": "title", "text": "text", "url": "url" } }
}
